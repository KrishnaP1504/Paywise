# ==============================================================================
# 🔐 PAYWISE ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env or pass variables via --dart-define during build:
# Example: flutter build apk --dart-define=FIREBASE_API_KEY=YOUR_KEY ...
# ==============================================================================

# --- FIREBASE CLIENT CONFIGURATION ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_DATABASE_URL=YOUR_FIREBASE_DATABASE_URL
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET

# --- OAUTH CLIENT CONFIGURATION ---
GOOGLE_SERVER_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# --- ANDROID RELEASE KEYSTORE CONFIGURATION (android/key.properties) ---
KEYSTORE_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
KEYSTORE_KEY_PASSWORD=YOUR_KEY_PASSWORD
KEYSTORE_KEY_ALIAS=YOUR_KEY_ALIAS
KEYSTORE_STORE_FILE=release-key.jks
